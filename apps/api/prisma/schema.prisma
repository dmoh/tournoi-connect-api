// Schéma de données Tournoi Connect (ADR-002, ADR-003).
// Champs en camelCase, tables et colonnes en snake_case ; montants en centimes ;
// horodatages en timestamptz. Toute donnée privée porte organizationId.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Sport {
  football
  handball
  basketball
  volleyball
  rugby
}

enum TournamentStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

/// Format choisi dans l'assistant (écran 03 de la maquette).
enum TournamentFormat {
  SINGLE_GROUP
  GROUPS_KNOCKOUT
  KNOCKOUT
  SWISS
}

enum Phase {
  groups
  round_of_32
  round_of_16
  quarter
  semi
  final
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
}

enum PostKind {
  ANNOUNCEMENT
  RESULT
  POLL
}

/// Origine d'un sponsor du carnet : nouvel annonceur du tournoi ou sponsor du club importé.
enum SponsorSource {
  TOURNAMENT
  CLUB
}

/// Pipeline d'un sponsor sur un tournoi : prospect → invité → payé.
enum SponsorStatus {
  PROSPECT
  INVITED
  PAID
}

enum PackTier {
  BRONZE
  SILVER
  GOLD
  FIELD
}

/// Emplacement mesuré : bannière exclusive (Or), bandeau partagé, logo de terrain, carte du fil.
enum Placement {
  BANNER_EXCLUSIVE
  BANNER_ROTATION
  FIELD_LOGO
  FEED_CARD
}

model Organization {
  id                   String          @id @default(cuid(2))
  slug                 String          @unique
  name                 String
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz
  venues               Venue[]
  tournaments          Tournament[]
  sponsors             Sponsor[]
  members              Membership[]
  invitations          Invitation[]
  /// Compte Stripe Connect (Express) du club : les inscriptions lui sont versées.
  stripeAccountId      String?         @unique @map("stripe_account_id")
  /// Paiements acceptés par Stripe (vérification du club terminée).
  stripeChargesEnabled Boolean         @default(false) @map("stripe_charges_enabled")
  /// Ville du club (affichée avec son nom).
  city                 String?
  /// Club importé d'un service externe (connecteur EcoClubSport, plus tard).
  externalSource       ExternalSource? @map("external_source")
  externalId           String?         @map("external_id")

  @@unique([externalSource, externalId])
  @@map("organization")
}

model Venue {
  id             String       @id @default(cuid(2))
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  city           String
  lat            Float
  lng            Float
  outdoor        Boolean
  tournaments    Tournament[]

  // Préfiltre de la découverte par rayon ; PostGIS (GiST) remplacera cet index.
  @@index([lat, lng])
  @@index([organizationId])
  @@map("venue")
}

model Tournament {
  id                   String              @id @default(cuid(2))
  organizationId       String              @map("organization_id")
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  venueId              String              @map("venue_id")
  venue                Venue               @relation(fields: [venueId], references: [id])
  slug                 String              @unique
  name                 String
  sport                Sport
  startsAt             DateTime            @map("starts_at") @db.Timestamptz
  endsAt               DateTime            @map("ends_at") @db.Timestamptz
  categories           String[]
  teamCount            Int                 @default(0) @map("team_count")
  maxTeams             Int                 @map("max_teams")
  feeCents             Int                 @default(0) @map("fee_cents")
  status               TournamentStatus    @default(DRAFT)
  format               TournamentFormat    @default(GROUPS_KNOCKOUT)
  fieldCount           Int                 @default(1) @map("field_count")
  matchMinutes         Int                 @default(15) @map("match_minutes")
  breakMinutes         Int                 @default(5) @map("break_minutes")
  registrationDeadline DateTime?           @map("registration_deadline") @db.Date
  teams                Team[]
  matches              Match[]
  posts                Post[]
  packages             SponsorPackage[]
  sponsors             TournamentSponsor[]
  registrations        Registration[]

  @@index([status, startsAt])
  @@index([organizationId])
  @@map("tournament")
}

model Team {
  id           String        @id @default(cuid(2))
  tournamentId String        @map("tournament_id")
  tournament   Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  /// Identifiant court stable dans le tournoi (ex. « eda »).
  code         String
  name         String
  shortName    String        @map("short_name")
  club         String
  group        String?
  players      Player[]
  registration Registration?

  @@unique([tournamentId, code])
  @@map("team")
}

/// Effectif d'une équipe, pour la feuille buteur du rapporteur (maquette 12b).
model Player {
  id     String @id @default(cuid(2))
  teamId String @map("team_id")
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  number Int
  name   String

  @@unique([teamId, number])
  @@map("player")
}

model Match {
  id              String          @id @default(cuid(2))
  tournamentId    String          @map("tournament_id")
  tournament      Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  /// Identifiant court stable dans le tournoi (ex. « a5 », « df1 »).
  code            String
  phase           Phase
  group           String?
  field           String
  startsAt        DateTime        @map("starts_at") @db.Timestamptz
  homeTeamCode    String?         @map("home_team_code")
  awayTeamCode    String?         @map("away_team_code")
  homePlaceholder String?         @map("home_placeholder")
  awayPlaceholder String?         @map("away_placeholder")
  scoreHome       Int             @default(0) @map("score_home")
  scoreAway       Int             @default(0) @map("score_away")
  status          MatchStatus     @default(SCHEDULED)
  minute          Int?
  /// Verrou optimiste du direct (ADR-009).
  version         Int             @default(0)
  events          MatchEvent[]
  reactions       MatchReaction[]

  @@unique([tournamentId, code])
  @@index([tournamentId, startsAt])
  @@map("match")
}

enum MatchEventType {
  GOAL
  YELLOW_CARD
  RED_CARD
  SAVE
  PHOTO
  HALF_TIME
  FULL_TIME
  /// Annule l'événement désigné par cancelsId (rien n'est effacé).
  CANCEL
}

enum Side {
  HOME
  AWAY
}

enum ReactionKind {
  CLAP
  FIRE
  WOW
}

/// Fil du direct, en insertion seule (cahier des charges, section 6).
model MatchEvent {
  id            String         @id @default(cuid(2))
  /// Ordre d'enregistrement : deux saisies de la même milliseconde gardent leur ordre.
  seq           Int            @default(autoincrement())
  matchId       String         @map("match_id")
  match         Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  /// Créé sur l'appareil du rapporteur : un doublon est ignoré (idempotence).
  clientEventId String         @map("client_event_id")
  type          MatchEventType
  side          Side?
  minute        Int
  player        String?
  assist        String?
  caption       String?
  cancelsId     String?        @map("cancels_id")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz

  @@unique([matchId, clientEventId])
  @@index([matchId, seq])
  @@map("match_event")
}

/// Réaction anonyme d'un spectateur : une par appareil et par emoji.
model MatchReaction {
  matchId   String       @map("match_id")
  match     Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  kind      ReactionKind
  deviceId  String       @map("device_id")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz

  @@id([matchId, kind, deviceId])
  @@map("match_reaction")
}

model Post {
  id           String       @id @default(cuid(2))
  tournamentId String       @map("tournament_id")
  tournament   Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  kind         PostKind
  title        String
  body         String
  matchCode    String?      @map("match_code")
  publishedAt  DateTime     @default(now()) @map("published_at") @db.Timestamptz
  options      PollOption[]

  @@index([tournamentId, publishedAt])
  @@map("post")
}

model PollOption {
  id       String @id @default(cuid(2))
  postId   String @map("post_id")
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  label    String
  position Int
  votes    Int    @default(0)

  @@unique([postId, position])
  @@map("poll_option")
}

/// Carnet de sponsors de l'organisation, réutilisé d'un tournoi à l'autre. Privé.
model Sponsor {
  id             String              @id @default(cuid(2))
  organizationId String              @map("organization_id")
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String?
  website        String?
  source         SponsorSource       @default(TOURNAMENT)
  tournaments    TournamentSponsor[]
  /// Comptes ayant l'accès exclusif du sponsor (ses statistiques).
  accesses       SponsorAccess[]

  @@index([organizationId])
  @@map("sponsor")
}

/// Packs vendus par tournoi (Bronze, Argent, Or, sponsor de terrain).
model SponsorPackage {
  id           String     @id @default(cuid(2))
  tournamentId String     @map("tournament_id")
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  tier         PackTier
  priceCents   Int        @map("price_cents")
  inventory    Int

  @@unique([tournamentId, tier])
  @@map("sponsor_package")
}

/// Un sponsor sur un tournoi : son avancement, son pack, son terrain.
model TournamentSponsor {
  id           String           @id @default(cuid(2))
  tournamentId String           @map("tournament_id")
  tournament   Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  sponsorId    String           @map("sponsor_id")
  sponsor      Sponsor          @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  status       SponsorStatus    @default(INVITED)
  tier         PackTier
  /// Terrain sponsorisé, pour un pack FIELD.
  field        String?
  invitedAt    DateTime?        @map("invited_at") @db.Timestamptz
  paidAt       DateTime?        @map("paid_at") @db.Timestamptz
  audience     AudienceHourly[]

  @@unique([tournamentId, sponsorId])
  @@index([tournamentId, status])
  @@map("tournament_sponsor")
}

/// Impressions et clics agrégés par heure (jamais d'événement brut lu par l'API).
model AudienceHourly {
  id                  String            @id @default(cuid(2))
  tournamentSponsorId String            @map("tournament_sponsor_id")
  tournamentSponsor   TournamentSponsor @relation(fields: [tournamentSponsorId], references: [id], onDelete: Cascade)
  placement           Placement
  hourBucket          DateTime          @map("hour_bucket") @db.Timestamptz
  impressions         Int               @default(0)
  clicks              Int               @default(0)

  @@unique([tournamentSponsorId, placement, hourBucket])
  @@map("audience_hourly")
}

// ---------------------------------------------------------------------------
// Comptes et rôles (lot 1)
// ---------------------------------------------------------------------------

/// Moyens de connexion d'un compte ; ECOCLUBSPORT est réservé au connecteur à venir.
enum IdentityProvider {
  EMAIL
  GOOGLE
  APPLE
  FACEBOOK
  ECOCLUBSPORT
}

enum ExternalSource {
  ECOCLUBSPORT
}

/// Rôle dans un club : propriétaire, administrateur, bénévole (saisie des scores).
enum MemberRole {
  OWNER
  ADMIN
  STAFF
}

model User {
  id                String             @id @default(cuid(2))
  /// Toujours en minuscules.
  email             String             @unique
  firstName         String?            @map("first_name")
  lastName          String?            @map("last_name")
  locale            String             @default("fr")
  /// Admin de la plateforme (support, modération).
  platformAdmin     Boolean            @default(false) @map("platform_admin")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  identities        Identity[]
  sessions          Session[]
  memberships       Membership[]
  sponsorAccess     SponsorAccess[]
  invitationsSent   Invitation[]       @relation("InvitedBy")
  registrations     Registration[]
  follows           Follow[]
  pushSubscriptions PushSubscription[]
  idempotencyKeys   IdempotencyKey[]

  @@map("app_user")
}

/// Moyen de connexion rattaché à un compte (une adresse, un compte Google…).
model Identity {
  id        String           @id @default(cuid(2))
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  IdentityProvider
  /// Identifiant chez le fournisseur (sub OIDC, id Facebook, adresse email).
  subject   String
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz

  @@unique([provider, subject])
  @@index([userId])
  @@map("identity")
}

/// Code à 6 chiffres envoyé par email, haché, valable 10 minutes, 5 essais.
model LoginCode {
  id         String    @id @default(cuid(2))
  email      String
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([email, createdAt])
  @@map("login_code")
}

/// Session d'un appareil : jeton de rafraîchissement haché, renouvelé à chaque usage.
model Session {
  id          String    @id @default(cuid(2))
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash String    @unique @map("refresh_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz
  userAgent   String?   @map("user_agent")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt  DateTime  @default(now()) @map("last_used_at") @db.Timestamptz

  @@index([userId])
  @@map("session")
}

model Membership {
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           MemberRole
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  @@id([userId, organizationId])
  @@index([organizationId])
  @@map("membership")
}

/// Accès exclusif d'un compte aux statistiques d'un sponsor.
model SponsorAccess {
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sponsorId String   @map("sponsor_id")
  sponsor   Sponsor  @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([userId, sponsorId])
  @@map("sponsor_access")
}

/// Invitation à rejoindre un club, envoyée par email : lien à usage unique
/// valable 7 jours, réservé à l'adresse invitée. Le jeton n'est gardé qu'haché.
model Invitation {
  id             String       @id @default(cuid(2))
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Toujours en minuscules.
  email          String
  role           MemberRole
  tokenHash      String       @unique @map("token_hash")
  invitedById    String?      @map("invited_by_id")
  invitedBy      User?        @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz
  acceptedAt     DateTime?    @map("accepted_at") @db.Timestamptz
  revokedAt      DateTime?    @map("revoked_at") @db.Timestamptz
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

enum RegistrationStatus {
  /// Place tenue pendant le paiement (Stripe Checkout, 30 minutes).
  PENDING_PAYMENT
  CONFIRMED
  WAITLISTED
  /// Paiement non abouti dans le délai : la place est rendue.
  EXPIRED
  CANCELLED
}

/// Inscription d'une équipe par son responsable (compte connecté). Confirmée,
/// elle crée l'équipe du tournoi.
model Registration {
  id                String             @id @default(cuid(2))
  tournamentId      String             @map("tournament_id")
  tournament        Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  /// Vide quand le compte du responsable a été supprimé (inscription anonymisée).
  managerId         String?            @map("manager_id")
  manager           User?              @relation(fields: [managerId], references: [id], onDelete: SetNull)
  teamName          String             @map("team_name")
  club              String
  managerName       String             @map("manager_name")
  phone             String
  /// Effectif : [{ firstName, lastName, number }].
  players           Json
  status            RegistrationStatus
  feeCents          Int                @map("fee_cents")
  serviceFeeCents   Int                @map("service_fee_cents")
  totalCents        Int                @map("total_cents")
  /// Clé Idempotency-Key de la demande : un renvoi rend la même inscription.
  idempotencyKey    String             @unique @map("idempotency_key")
  checkoutSessionId String?            @unique @map("checkout_session_id")
  checkoutUrl       String?            @map("checkout_url")
  /// Fin de la place tenue pendant le paiement.
  expiresAt         DateTime?          @map("expires_at") @db.Timestamptz
  paymentIntentId   String?            @map("payment_intent_id")
  paidAt            DateTime?          @map("paid_at") @db.Timestamptz
  teamId            String?            @unique @map("team_id")
  team              Team?              @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz

  @@index([tournamentId, status])
  @@index([managerId])
  @@map("registration")
}

enum FollowKind {
  TOURNAMENT
  TEAM
}

/// Suivi d'un tournoi (slug) ou d'une équipe (« slug/code ») par un compte :
/// les suivis de chaque appareil s'y fusionnent à la connexion.
model Follow {
  userId    String     @map("user_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      FollowKind
  target    String
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@id([userId, kind, target])
  @@index([kind, target])
  @@map("follow")
}

/// Abonnement aux notifications d'un navigateur (Web Push), avec les suivis
/// de l'appareil et ses préférences ; relié au compte quand on est connecté.
model PushSubscription {
  id          String    @id @default(cuid(2))
  endpoint    String    @unique
  p256dh      String
  auth        String
  userId      String?   @map("user_id")
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  tournaments String[]
  teams       String[]
  kickoff     Boolean   @default(true)
  goals       Boolean   @default(true)
  results     Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  lastSentAt  DateTime? @map("last_sent_at") @db.Timestamptz

  @@index([userId])
  @@map("push_subscription")
}

/// Écriture rejouable par sa clé Idempotency-Key pendant 24 heures : même
/// compte, même portée et même clé rendent la réponse enregistrée. La
/// contrainte unique fait qu'une seule requête s'exécute ; une ligne sans
/// statut est une requête encore en cours.
model IdempotencyKey {
  id          String   @id @default(cuid(2))
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Club, méthode et chemin : « etoile-de-l-arve POST /api/v1/organizer/tournaments ».
  scope       String
  key         String
  /// SHA-256 du corps de la requête : la même clé sur un autre corps est refusée.
  fingerprint String
  /// Statut HTTP de la réponse ; vide tant que la requête est en cours.
  status      Int?
  response    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([userId, scope, key])
  @@index([createdAt])
  @@map("idempotency_key")
}
