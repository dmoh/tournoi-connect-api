// Schéma de données Tournoi Connect (ADR-002, ADR-003).
// Champs en camelCase, tables et colonnes en snake_case ; montants en centimes ;
// horodatages en timestamptz. Toute donnée privée porte organizationId.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Sport {
  football
  handball
  basketball
  volleyball
  rugby
}

enum TournamentStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
  /// Annulé par le club (intempéries, salle indisponible) : la page publique
  /// l'annonce, les équipes sont remboursées.
  CANCELLED
}

/// Format choisi dans l'assistant (écran 03 de la maquette).
enum TournamentFormat {
  SINGLE_GROUP
  GROUPS_KNOCKOUT
  KNOCKOUT
  SWISS
}

enum Phase {
  groups
  round_of_32
  round_of_16
  quarter
  semi
  /// Petite finale (match pour la 3e place).
  third_place
  final
  /// Ronde de système suisse (appariée au fil des résultats).
  swiss
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
}

enum PostKind {
  ANNOUNCEMENT
  RESULT
  POLL
}

/// Origine d'un sponsor du carnet : nouvel annonceur du tournoi ou sponsor du club importé.
enum SponsorSource {
  TOURNAMENT
  CLUB
}

/// Pipeline d'un sponsor sur un tournoi : prospect → invité → payé.
enum SponsorStatus {
  PROSPECT
  INVITED
  PAID
}

enum PackTier {
  BRONZE
  SILVER
  GOLD
  FIELD
}

/// Emplacement mesuré : bannière exclusive (Or), bandeau partagé, logo de terrain, carte du fil.
enum Placement {
  BANNER_EXCLUSIVE
  BANNER_ROTATION
  FIELD_LOGO
  FEED_CARD
}

model Organization {
  id                   String          @id @default(cuid(2))
  slug                 String          @unique
  name                 String
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz
  venues               Venue[]
  tournaments          Tournament[]
  sponsors             Sponsor[]
  members              Membership[]
  invitations          Invitation[]
  reporterLinks        ReporterLink[]
  editionInvites       EditionInvite[]
  /// Compte Stripe Connect (Express) du club : les inscriptions lui sont versées.
  stripeAccountId      String?         @unique @map("stripe_account_id")
  /// Paiements acceptés par Stripe (vérification du club terminée).
  stripeChargesEnabled Boolean         @default(false) @map("stripe_charges_enabled")
  /// Ville du club (affichée avec son nom).
  city                 String?
  /// Club importé d'un service externe (connecteur EcoClubSport, plus tard).
  externalSource       ExternalSource? @map("external_source")
  externalId           String?         @map("external_id")
  /// Code de parrainage du club (lien « /clubs/new?parrain=… »), créé au premier partage.
  referralCode         String?         @unique @map("referral_code")
  /// Club qui a parrainé celui-ci (suivi seulement : aucun avantage pour l'instant).
  referredById         String?         @map("referred_by_id")
  referredBy           Organization?   @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals            Organization[]  @relation("Referrals")
  /// Facturation (lot 15) : identité légale du club, vendeur des packs sponsors.
  legalName            String?         @map("legal_name")
  /// Adresse du siège : rue (une ou plusieurs lignes), code postal, ville.
  billingStreet        String?         @map("billing_street")
  billingPostalCode    String?         @map("billing_postal_code")
  billingCity          String?         @map("billing_city")
  /// SIRET (14 chiffres) ou, pour une association sans SIRET, numéro RNA.
  siret                String?
  rna                  String?
  /// Club assujetti à la TVA : 20 % sur les packs, numéro intracommunautaire.
  vatRegistered        Boolean         @default(false) @map("vat_registered")
  vatNumber            String?         @map("vat_number")
  /// Mention portée sur la facture d'un club non assujetti.
  vatExemptionNote     String?         @map("vat_exemption_note")
  /// Dernier numéro de facture attribué : la suite est continue, sans trou.
  invoiceSequence      Int             @default(0) @map("invoice_sequence")
  invoices             Invoice[]

  @@unique([externalSource, externalId])
  @@map("organization")
}

model Venue {
  id             String       @id @default(cuid(2))
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  city           String
  lat            Float
  lng            Float
  outdoor        Boolean
  tournaments    Tournament[]

  // Préfiltre de la découverte par rayon ; PostGIS (GiST) remplacera cet index.
  @@index([lat, lng])
  @@index([organizationId])
  @@map("venue")
}

model Tournament {
  id                    String              @id @default(cuid(2))
  organizationId        String              @map("organization_id")
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  venueId               String              @map("venue_id")
  venue                 Venue               @relation(fields: [venueId], references: [id])
  slug                  String              @unique
  name                  String
  sport                 Sport
  startsAt              DateTime            @map("starts_at") @db.Timestamptz
  endsAt                DateTime            @map("ends_at") @db.Timestamptz
  categories            String[]
  teamCount             Int                 @default(0) @map("team_count")
  maxTeams              Int                 @map("max_teams")
  feeCents              Int                 @default(0) @map("fee_cents")
  status                TournamentStatus    @default(DRAFT)
  format                TournamentFormat    @default(GROUPS_KNOCKOUT)
  fieldCount            Int                 @default(1) @map("field_count")
  matchMinutes          Int                 @default(15) @map("match_minutes")
  breakMinutes          Int                 @default(5) @map("break_minutes")
  registrationDeadline  DateTime?           @map("registration_deadline") @db.Date
  /// Masqué par la modération de la plateforme : la page publique répond 404.
  hiddenAt              DateTime?           @map("hidden_at") @db.Timestamptz
  /// Graine du dernier tirage des poules : le même tirage se refait à l'identique.
  drawSeed              String?             @map("draw_seed")
  /// Système suisse : nombre de rondes, fixé au tirage de la première.
  swissRounds           Int?                @map("swiss_rounds")
  /// Règles de classement choisies par l'organisateur (points, départages) ;
  /// vide : celles du sport (moteur, SPORT_RULES).
  rankingRules          Json?               @map("ranking_rules")
  /// Annulation par le propriétaire du club : date et motif affiché au public.
  cancelledAt           DateTime?           @map("cancelled_at") @db.Timestamptz
  cancellationReason    String?             @map("cancellation_reason")
  /// Convocations des équipes envoyées (J-2, ou à la main par le club).
  convocationsSentAt    DateTime?           @map("convocations_sent_at") @db.Timestamptz
  /// Dernier changement du calendrier (tirage, planning) : une convocation déjà
  /// partie est renvoyée une fois les changements terminés.
  scheduleChangedAt     DateTime?           @map("schedule_changed_at") @db.Timestamptz
  /// Édition précédente, quand le tournoi a été préparé depuis elle.
  previousEditionId     String?             @map("previous_edition_id")
  previousEdition       Tournament?         @relation("Editions", fields: [previousEditionId], references: [id], onDelete: SetNull)
  nextEditions          Tournament[]        @relation("Editions")
  /// Responsables des équipes de l'édition précédente invités à s'inscrire.
  editionInvitesSentAt  DateTime?           @map("edition_invites_sent_at") @db.Timestamptz
  /// Partenaires de l'édition précédente invités à renouveler leur pack.
  sponsorRenewalsSentAt DateTime?           @map("sponsor_renewals_sent_at") @db.Timestamptz
  reports               Report[]
  photos                Photo[]
  teams                 Team[]
  matches               Match[]
  posts                 Post[]
  packages              SponsorPackage[]
  sponsors              TournamentSponsor[]
  registrations         Registration[]
  editionInvites        EditionInvite[]

  @@index([status, startsAt])
  @@index([organizationId])
  /// Écran 01 paginé : (startsAt, id) dans le club.
  @@index([organizationId, startsAt, id])
  @@map("tournament")
}

model Team {
  id           String        @id @default(cuid(2))
  tournamentId String        @map("tournament_id")
  tournament   Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  /// Identifiant court stable dans le tournoi (ex. « eda »).
  code         String
  name         String
  shortName    String        @map("short_name")
  club         String
  group        String?
  /// Système suisse : rondes où l'équipe a été exempte (victoire sans but).
  byeRounds    Int[]         @default([]) @map("bye_rounds")
  /// Jour J : arrivée signalée par le responsable ou pointée par le club.
  arrivedAt    DateTime?     @map("arrived_at") @db.Timestamptz
  /// Forfait déclaré par le club : ses matchs restants sont perdus.
  forfeitAt    DateTime?     @map("forfeit_at") @db.Timestamptz
  players      Player[]
  registration Registration?

  @@unique([tournamentId, code])
  @@map("team")
}

/// Effectif d'une équipe, pour la feuille buteur du rapporteur (maquette 12b).
model Player {
  id     String @id @default(cuid(2))
  teamId String @map("team_id")
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  number Int
  name   String

  @@unique([teamId, number])
  @@map("player")
}

model Match {
  id              String          @id @default(cuid(2))
  tournamentId    String          @map("tournament_id")
  tournament      Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  /// Identifiant court stable dans le tournoi (ex. « a5 », « df1 »).
  code            String
  phase           Phase
  group           String?
  /// Numéro de ronde du système suisse (null pour les autres formats).
  round           Int?
  field           String
  startsAt        DateTime        @map("starts_at") @db.Timestamptz
  homeTeamCode    String?         @map("home_team_code")
  awayTeamCode    String?         @map("away_team_code")
  homePlaceholder String?         @map("home_placeholder")
  awayPlaceholder String?         @map("away_placeholder")
  /// Origine d'une place du tableau (« group:A:1 », « winner:df1 », « loser:df1 ») :
  /// l'équipe y est placée dès que la poule ou le match est terminé.
  homeSource      String?         @map("home_source")
  awaySource      String?         @map("away_source")
  /// Vainqueur d'un match à élimination terminé sur un nul (tirs au but).
  winnerSide      Side?           @map("winner_side")
  /// Équipe déclarée forfait pour ce match (score de forfait du sport).
  forfeit         Side?
  scoreHome       Int             @default(0) @map("score_home")
  scoreAway       Int             @default(0) @map("score_away")
  status          MatchStatus     @default(SCHEDULED)
  minute          Int?
  /// Verrou optimiste du direct (ADR-009).
  version         Int             @default(0)
  events          MatchEvent[]
  reactions       MatchReaction[]
  reporterLinks   ReporterLink[]
  photos          Photo[]

  @@unique([tournamentId, code])
  @@index([tournamentId, startsAt])
  @@map("match")
}

enum MatchEventType {
  GOAL
  YELLOW_CARD
  RED_CARD
  SAVE
  PHOTO
  HALF_TIME
  FULL_TIME
  /// Annule l'événement désigné par cancelsId (rien n'est effacé).
  CANCEL
}

enum Side {
  HOME
  AWAY
}

enum ReactionKind {
  CLAP
  FIRE
  WOW
}

/// Fil du direct, en insertion seule (cahier des charges, section 6).
model MatchEvent {
  id            String         @id @default(cuid(2))
  /// Ordre d'enregistrement : deux saisies de la même milliseconde gardent leur ordre.
  seq           Int            @default(autoincrement())
  matchId       String         @map("match_id")
  match         Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  /// Créé sur l'appareil du rapporteur : un doublon est ignoré (idempotence).
  clientEventId String         @map("client_event_id")
  type          MatchEventType
  side          Side?
  minute        Int
  player        String?
  assist        String?
  caption       String?
  cancelsId     String?        @map("cancels_id")
  /// Photo jointe à un événement PHOTO (envoyée et confirmée avant l'événement).
  photoId       String?        @map("photo_id")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz

  @@unique([matchId, clientEventId])
  @@index([matchId, seq])
  @@map("match_event")
}

/// Lien de la table de marque : son identifiant est signé dans le jeton ; il
/// se révoque (match, membre retiré du club) et expire au bout de 24 heures.
model ReporterLink {
  id             String       @id @default(cuid(2))
  matchId        String       @map("match_id")
  match          Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Membre qui l'a émis ; la suppression de son compte supprime ses liens.
  issuedById     String       @map("issued_by_id")
  issuedBy       User         @relation(fields: [issuedById], references: [id], onDelete: Cascade)
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz
  revokedAt      DateTime?    @map("revoked_at") @db.Timestamptz
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  @@index([matchId])
  @@index([issuedById, organizationId])
  @@map("reporter_link")
}

/// Réaction anonyme d'un spectateur : une par appareil et par emoji.
model MatchReaction {
  matchId   String       @map("match_id")
  match     Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  kind      ReactionKind
  deviceId  String       @map("device_id")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz

  @@id([matchId, kind, deviceId])
  @@map("match_reaction")
}

model Post {
  id           String       @id @default(cuid(2))
  tournamentId String       @map("tournament_id")
  tournament   Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  kind         PostKind
  title        String
  body         String
  matchCode    String?      @map("match_code")
  publishedAt  DateTime     @default(now()) @map("published_at") @db.Timestamptz
  /// Masqué par la modération de la plateforme (signalement) : plus affiché.
  hiddenAt     DateTime?    @map("hidden_at") @db.Timestamptz
  options      PollOption[]

  @@index([tournamentId, publishedAt])
  /// Fil News paginé : (publishedAt, id) décroissants.
  @@index([tournamentId, publishedAt, id])
  @@map("post")
}

model PollOption {
  id       String @id @default(cuid(2))
  postId   String @map("post_id")
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  label    String
  position Int
  votes    Int    @default(0)

  @@unique([postId, position])
  @@map("poll_option")
}

/// Carnet de sponsors de l'organisation, réutilisé d'un tournoi à l'autre. Privé.
model Sponsor {
  id             String              @id @default(cuid(2))
  organizationId String              @map("organization_id")
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String?
  website        String?
  source         SponsorSource       @default(TOURNAMENT)
  tournaments    TournamentSponsor[]
  /// Comptes ayant l'accès exclusif du sponsor (ses statistiques).
  accesses       SponsorAccess[]

  @@index([organizationId])
  @@map("sponsor")
}

/// Packs vendus par tournoi (Bronze, Argent, Or, sponsor de terrain).
model SponsorPackage {
  id           String     @id @default(cuid(2))
  tournamentId String     @map("tournament_id")
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  tier         PackTier
  priceCents   Int        @map("price_cents")
  inventory    Int

  @@unique([tournamentId, tier])
  @@map("sponsor_package")
}

/// Un sponsor sur un tournoi : son avancement, son pack, son terrain.
model TournamentSponsor {
  id                String           @id @default(cuid(2))
  tournamentId      String           @map("tournament_id")
  tournament        Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  sponsorId         String           @map("sponsor_id")
  sponsor           Sponsor          @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  status            SponsorStatus    @default(INVITED)
  tier              PackTier
  /// Terrain sponsorisé, pour un pack FIELD.
  field             String?
  invitedAt         DateTime?        @map("invited_at") @db.Timestamptz
  paidAt            DateTime?        @map("paid_at") @db.Timestamptz
  /// Empreinte (SHA-256) du lien de paiement envoyé au sponsor ; le lien lui-même n'est pas gardé.
  inviteTokenHash   String?          @unique @map("invite_token_hash")
  /// Dernière page de paiement Stripe ouverte par le sponsor.
  checkoutSessionId String?          @unique @map("checkout_session_id")
  /// Paiement en ligne (Stripe) ; vide pour un paiement marqué à la main.
  paymentIntentId   String?          @unique @map("payment_intent_id")
  /// Prix du pack et frais de service payés en ligne, en centimes.
  amountCents       Int?             @map("amount_cents")
  serviceFeeCents   Int?             @map("service_fee_cents")
  /// Adresse de facturation saisie par le sponsor sur la page de paiement.
  billingAddress    Json?            @map("billing_address")
  invoice           Invoice?
  audience          AudienceHourly[]

  @@unique([tournamentId, sponsorId])
  @@index([tournamentId, status])
  @@map("tournament_sponsor")
}

/// Impressions et clics agrégés par heure (jamais d'événement brut lu par l'API).
model AudienceHourly {
  id                  String            @id @default(cuid(2))
  tournamentSponsorId String            @map("tournament_sponsor_id")
  tournamentSponsor   TournamentSponsor @relation(fields: [tournamentSponsorId], references: [id], onDelete: Cascade)
  placement           Placement
  hourBucket          DateTime          @map("hour_bucket") @db.Timestamptz
  impressions         Int               @default(0)
  clicks              Int               @default(0)

  @@unique([tournamentSponsorId, placement, hourBucket])
  @@map("audience_hourly")
}

// ---------------------------------------------------------------------------
// Comptes et rôles (lot 1)
// ---------------------------------------------------------------------------

/// Moyens de connexion d'un compte ; ECOCLUBSPORT est réservé au connecteur à venir.
enum IdentityProvider {
  EMAIL
  GOOGLE
  APPLE
  FACEBOOK
  ECOCLUBSPORT
}

enum ExternalSource {
  ECOCLUBSPORT
}

/// Rôle dans un club : propriétaire, administrateur, bénévole (saisie des scores).
enum MemberRole {
  OWNER
  ADMIN
  STAFF
}

model User {
  id                String             @id @default(cuid(2))
  /// Toujours en minuscules.
  email             String             @unique
  firstName         String?            @map("first_name")
  lastName          String?            @map("last_name")
  locale            String             @default("fr")
  /// Admin de la plateforme (support, modération).
  platformAdmin     Boolean            @default(false) @map("platform_admin")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  identities        Identity[]
  sessions          Session[]
  memberships       Membership[]
  sponsorAccess     SponsorAccess[]
  invitationsSent   Invitation[]       @relation("InvitedBy")
  registrations     Registration[]
  follows           Follow[]
  pushSubscriptions PushSubscription[]
  idempotencyKeys   IdempotencyKey[]
  reporterLinks     ReporterLink[]
  photos            Photo[]

  @@map("app_user")
}

/// Moyen de connexion rattaché à un compte (une adresse, un compte Google…).
model Identity {
  id        String           @id @default(cuid(2))
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  IdentityProvider
  /// Identifiant chez le fournisseur (sub OIDC, id Facebook, adresse email).
  subject   String
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz

  @@unique([provider, subject])
  @@index([userId])
  @@map("identity")
}

/// Code à 6 chiffres envoyé par email, haché, valable 10 minutes, 5 essais.
model LoginCode {
  id         String    @id @default(cuid(2))
  email      String
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([email, createdAt])
  @@map("login_code")
}

/// Session d'un appareil : jeton de rafraîchissement haché, renouvelé à chaque usage.
model Session {
  id          String    @id @default(cuid(2))
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash String    @unique @map("refresh_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz
  userAgent   String?   @map("user_agent")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt  DateTime  @default(now()) @map("last_used_at") @db.Timestamptz

  @@index([userId])
  @@map("session")
}

model Membership {
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           MemberRole
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  @@id([userId, organizationId])
  @@index([organizationId])
  /// Écran des membres paginé : (rôle, arrivée, compte).
  @@index([organizationId, role, createdAt, userId])
  @@map("membership")
}

/// Accès exclusif d'un compte aux statistiques d'un sponsor.
model SponsorAccess {
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sponsorId String   @map("sponsor_id")
  sponsor   Sponsor  @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([userId, sponsorId])
  @@map("sponsor_access")
}

/// Invitation à rejoindre un club, envoyée par email : lien à usage unique
/// valable 7 jours, réservé à l'adresse invitée. Le jeton n'est gardé qu'haché.
model Invitation {
  id             String       @id @default(cuid(2))
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Toujours en minuscules.
  email          String
  role           MemberRole
  tokenHash      String       @unique @map("token_hash")
  invitedById    String?      @map("invited_by_id")
  invitedBy      User?        @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz
  acceptedAt     DateTime?    @map("accepted_at") @db.Timestamptz
  revokedAt      DateTime?    @map("revoked_at") @db.Timestamptz
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  @@index([organizationId])
  @@index([email])
  /// Invitations en attente, les plus récentes d'abord.
  @@index([organizationId, createdAt])
  @@map("invitation")
}

enum RegistrationStatus {
  /// Place tenue pendant le paiement (Stripe Checkout, 30 minutes), ou
  /// proposée depuis la liste d'attente jusqu'à `paymentDueAt`.
  PENDING_PAYMENT
  CONFIRMED
  WAITLISTED
  /// Paiement non abouti dans le délai : la place est rendue.
  EXPIRED
  CANCELLED
}

/// Origine d'une inscription annulée par le club (vide : remboursement
/// automatique d'un paiement arrivé trop tard).
enum Cancellation {
  /// Équipe désistée par l'organisateur.
  WITHDRAWN
  /// Tournoi annulé.
  TOURNAMENT_CANCELLED
}

/// Inscription d'une équipe par son responsable (compte connecté). Confirmée,
/// elle crée l'équipe du tournoi.
model Registration {
  id                String             @id @default(cuid(2))
  tournamentId      String             @map("tournament_id")
  tournament        Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  /// Vide quand le compte du responsable a été supprimé (inscription anonymisée).
  managerId         String?            @map("manager_id")
  manager           User?              @relation(fields: [managerId], references: [id], onDelete: SetNull)
  teamName          String             @map("team_name")
  club              String
  managerName       String             @map("manager_name")
  phone             String
  /// Effectif : [{ firstName, lastName, number }].
  players           Json
  status            RegistrationStatus
  feeCents          Int                @map("fee_cents")
  serviceFeeCents   Int                @map("service_fee_cents")
  totalCents        Int                @map("total_cents")
  /// Clé Idempotency-Key de la demande : un renvoi rend la même inscription.
  idempotencyKey    String             @unique @map("idempotency_key")
  checkoutSessionId String?            @unique @map("checkout_session_id")
  checkoutUrl       String?            @map("checkout_url")
  /// Fin de la place tenue pendant le paiement.
  expiresAt         DateTime?          @map("expires_at") @db.Timestamptz
  /// Place proposée depuis la liste d'attente : la tenir jusqu'à cette date
  /// limite de paiement (48 h) ; vide pour une inscription directe.
  paymentDueAt      DateTime?          @map("payment_due_at") @db.Timestamptz
  paymentIntentId   String?            @map("payment_intent_id")
  paidAt            DateTime?          @map("paid_at") @db.Timestamptz
  teamId            String?            @unique @map("team_id")
  team              Team?              @relation(fields: [teamId], references: [id], onDelete: SetNull)
  cancellation      Cancellation?
  cancelledAt       DateTime?          @map("cancelled_at") @db.Timestamptz
  /// Lien personnel « Nous sommes arrivés » (convocation, sans connexion).
  arrivalToken      String             @unique @default(dbgenerated("(gen_random_uuid())::text")) @map("arrival_token")
  /// Montant à rendre au responsable après une annulation par le club
  /// (centimes) ; vide ou 0 : rien à rembourser.
  refundCents       Int?               @map("refund_cents")
  /// Remboursement passé chez Stripe (le worker le fait, et le rattrape).
  refundedAt        DateTime?          @map("refunded_at") @db.Timestamptz
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz

  @@index([tournamentId, status])
  /// Offres de la liste d'attente arrivées à échéance (balayage du worker).
  @@index([status, paymentDueAt])
  @@index([managerId])
  /// Mes équipes paginées : (createdAt, id) décroissants.
  @@index([managerId, createdAt, id])
  /// Tableau organisateur : tri par date ou par nom d'équipe, puis id.
  @@index([tournamentId, createdAt, id])
  @@index([tournamentId, teamName, id])
  /// Remboursements en attente (rattrapage du worker).
  @@index([refundedAt, refundCents])
  @@map("registration")
}

enum FollowKind {
  TOURNAMENT
  TEAM
}

/// Suivi d'un tournoi (slug) ou d'une équipe (« slug/code ») par un compte :
/// les suivis de chaque appareil s'y fusionnent à la connexion.
model Follow {
  userId    String     @map("user_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      FollowKind
  target    String
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@id([userId, kind, target])
  @@index([kind, target])
  @@map("follow")
}

/// Abonnement aux notifications d'un navigateur (Web Push), avec les suivis
/// de l'appareil et ses préférences ; relié au compte quand on est connecté.
model PushSubscription {
  id          String    @id @default(cuid(2))
  endpoint    String    @unique
  p256dh      String
  auth        String
  userId      String?   @map("user_id")
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  tournaments String[]
  teams       String[]
  kickoff     Boolean   @default(true)
  goals       Boolean   @default(true)
  results     Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  lastSentAt  DateTime? @map("last_sent_at") @db.Timestamptz

  @@index([userId])
  /// Ciblage des notifications (`has`, `hasSome` sur les tableaux).
  @@index([tournaments], type: Gin)
  @@index([teams], type: Gin)
  @@map("push_subscription")
}

/// Écriture rejouable par sa clé Idempotency-Key pendant 24 heures : même
/// compte, même portée et même clé rendent la réponse enregistrée. La
/// contrainte unique fait qu'une seule requête s'exécute ; une ligne sans
/// statut est une requête encore en cours.
model IdempotencyKey {
  id          String   @id @default(cuid(2))
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Club, méthode et chemin : « etoile-de-l-arve POST /api/v1/organizer/tournaments ».
  scope       String
  key         String
  /// SHA-256 du corps de la requête : la même clé sur un autre corps est refusée.
  fingerprint String
  /// Statut HTTP de la réponse ; vide tant que la requête est en cours.
  status      Int?
  response    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([userId, scope, key])
  @@index([createdAt])
  @@map("idempotency_key")
}

/// Événement Stripe (webhook) déjà traité : un renvoi du même identifiant
/// est sans effet, et un account.updated plus ancien n'écrase pas l'état.
model StripeEvent {
  /// Identifiant Stripe de l'événement (evt_…).
  id              String    @id
  type            String
  /// Objet concerné (compte, session) : ordre des account.updated.
  objectId        String?   @map("object_id")
  /// Date de création de l'événement chez Stripe (champ created).
  stripeCreatedAt DateTime? @map("stripe_created_at") @db.Timestamptz
  receivedAt      DateTime  @default(now()) @map("received_at") @db.Timestamptz

  @@index([objectId, type])
  @@map("stripe_event")
}

enum ReportReason {
  /// Contenu manifestement illicite.
  ILLEGAL
  /// Propos injurieux, harcèlement, discrimination.
  ABUSE
  /// Atteinte à la vie privée (photo, nom d'un mineur…).
  PRIVACY
  /// Publicité abusive, arnaque.
  SPAM
  OTHER
}

enum ReportStatus {
  OPEN
  /// Contenu masqué par la modération.
  HIDDEN
  /// Signalement écarté : rien à retirer.
  DISMISSED
}

/// Signalement d'un contenu public (tournoi ou actualité), par un compte ou
/// anonymement : traité par les admins de la plateforme (LCEN, retrait prompt
/// d'un contenu manifestement illicite).
model Report {
  id           String       @id @default(cuid(2))
  tournamentId String       @map("tournament_id")
  tournament   Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  /// Actualité signalée ; vide : la page du tournoi elle-même.
  postId       String?      @map("post_id")
  /// Photo signalée (temps fort, photo d'un match).
  photoId      String?      @map("photo_id")
  reason       ReportReason
  details      String       @default("")
  /// Adresse laissée pour être recontacté (facultative).
  contactEmail String?      @map("contact_email")
  status       ReportStatus @default(OPEN)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  resolvedAt   DateTime?    @map("resolved_at") @db.Timestamptz
  resolvedById String?      @map("resolved_by_id")

  @@index([status, createdAt])
  @@index([tournamentId])
  @@map("report")
}

enum PhotoStatus {
  /// URL d'envoi délivrée, fichier pas encore vérifié.
  PENDING
  /// Fichier vérifié (taille, type) : publié.
  READY
}

enum PhotoSource {
  /// Table de marque (lien du rapporteur).
  REPORTER
  /// Membre du club, depuis l'espace organisateur.
  CLUB
}

/**
 * Photo d'un tournoi (ou d'un match), stockée dans le bucket privé et servie
 * par CloudFront. Redimensionnée et sans métadonnées (EXIF, GPS) dès
 * l'appareil ; l'objet est effacé du stockage par le worker (removedAt).
 */
model Photo {
  id           String      @id @default(cuid(2))
  tournamentId String      @map("tournament_id")
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matchId      String?     @map("match_id")
  match        Match?      @relation(fields: [matchId], references: [id], onDelete: SetNull)
  /// Clé de l'objet dans le bucket (photos/<tournoi>/<photo>.<ext>).
  storageKey   String      @unique @map("storage_key")
  contentType  String      @map("content_type")
  bytes        Int
  width        Int
  height       Int
  caption      String?
  source       PhotoSource
  /// Membre du club qui l'a envoyée ; vide pour la table de marque.
  uploadedById String?     @map("uploaded_by_id")
  uploadedBy   User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  status       PhotoStatus @default(PENDING)
  /// Mise en avant par le club : temps fort affiché dans le fil.
  highlight    Boolean     @default(false)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  /// Retirée par le club, la table de marque (annulation) ou avec le compte.
  deletedAt    DateTime?   @map("deleted_at") @db.Timestamptz
  /// Masquée par la modération de la plateforme.
  hiddenAt     DateTime?   @map("hidden_at") @db.Timestamptz
  /// Objet effacé du bucket.
  removedAt    DateTime?   @map("removed_at") @db.Timestamptz

  @@index([tournamentId, createdAt])
  @@index([matchId])
  @@map("photo")
}

/// Facture d'un pack sponsor, émise au nom du club (lot 15). Figée à
/// l'émission : vendeur, acheteur et montants ne changent plus.
model Invoice {
  id                  String            @id @default(cuid(2))
  organizationId      String            @map("organization_id")
  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tournamentSponsorId String            @unique @map("tournament_sponsor_id")
  tournamentSponsor   TournamentSponsor @relation(fields: [tournamentSponsorId], references: [id], onDelete: Restrict)
  /// Rang dans la suite du club (1, 2, 3…) et numéro affiché (« FA-2026-0001 »).
  sequence            Int
  number              String
  issuedAt            DateTime          @map("issued_at") @db.Timestamptz
  paidAt              DateTime          @map("paid_at") @db.Timestamptz
  /// Identité du club et du sponsor au jour de l'émission.
  seller              Json
  buyer               Json
  label               String
  /// Montants en centimes : hors taxe, TVA (taux en points de base) et TTC.
  netCents            Int               @map("net_cents")
  vatRateBp           Int               @map("vat_rate_bp")
  vatCents            Int               @map("vat_cents")
  totalCents          Int               @map("total_cents")
  /// Paiement en ligne (Stripe), vide pour un pack réglé directement au club.
  paymentIntentId     String?           @map("payment_intent_id")
  /// Empreinte (SHA-256) du lien de consultation envoyé au sponsor.
  accessTokenHash     String            @unique @map("access_token_hash")

  @@unique([organizationId, sequence])
  @@unique([organizationId, number])
  @@map("invoice")
}

/// Invitation d'un responsable d'équipe à l'édition suivante d'un tournoi :
/// une par adresse et par édition. Son jeton sert au lien de désinscription ;
/// une adresse désinscrite n'est plus invitée par le club.
model EditionInvite {
  id             String       @id @default(cuid())
  token          String       @unique @default(dbgenerated("(gen_random_uuid())::text"))
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tournamentId   String       @map("tournament_id")
  tournament     Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  email          String
  sentAt         DateTime     @default(now()) @map("sent_at") @db.Timestamptz
  optedOutAt     DateTime?    @map("opted_out_at") @db.Timestamptz
  /// Email déposé dans la file : une relance du travail ne le renvoie pas.
  mailedAt       DateTime?    @map("mailed_at") @db.Timestamptz

  @@unique([tournamentId, email])
  @@index([organizationId, email])
  @@map("edition_invite")
}
