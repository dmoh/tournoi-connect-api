{
  "name": "@tournoi-connect/api",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "start:worker:dev": "nest start --watch --entryFile worker",
    "openapi": "prisma generate && nest build && node dist/openapi.js",
    "lint": "prisma generate && oxlint --type-aware src/ test/",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "prisma generate && vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "prisma generate && vitest run --config ./vitest.config.e2e.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node dist/database/seed.js",
    "vapid:keys": "node -e \"const c=require('node:crypto').createECDH('prime256v1');c.generateKeys();console.log('VAPID_PUBLIC_KEY='+c.getPublicKey('base64url'));console.log('VAPID_PRIVATE_KEY='+c.getPrivateKey('base64url'))\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1160.0",
    "@aws-sdk/client-sesv2": "3.1160.0",
    "@aws-sdk/s3-request-presigner": "3.1160.0",
    "@dmoh/tournoi-connect-engine": "workspace:*",
    "@fastify/helmet": "^13.2.0",
    "@fastify/static": "^10.1.10",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "^12.4.2",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-fastify": "^12.4.2",
    "@nestjs/swagger": "^12.1.1",
    "@nestjs/terminus": "^12.1.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "6.5.0",
    "fastify": "^5.12.8",
    "ioredis": "6.0.0",
    "jose": "6.2.14",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.4.2",
    "@types/node": "^26.6.6",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "^5.1.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.1.0"
  }
}
