# Copier en .env pour le développement local (jamais commité).
NODE_ENV=development
PORT=3000
# Origine publique de la PWA (liens dans les emails, redirections).
PUBLIC_APP_URL=http://localhost:4200
DATABASE_URL=postgresql://tournoi:tournoi@localhost:5432/tournoi_connect
REDIS_URL=redis://localhost:6379
LOG_LEVEL=debug
# Secret des comptes (jetons, codes de connexion, liens rapporteur) : 32 caractères minimum.
# Générer une valeur locale, par exemple : openssl rand -hex 32
AUTH_SECRET=
# Préprod seulement : code fixe à 6 chiffres des comptes de test @example.org, actif
# seulement avec ALLOW_TEST_ACCOUNTS=true. L'API refuse de démarrer si l'une des deux est
# renseignée avec PUBLIC_APP_URL=https://app.tournoi-connect.com (production).
TEST_ACCOUNTS_CODE=
ALLOW_TEST_ACCOUNTS=
# Paiements (Stripe Connect, mode test hors prod) : clé secrète et secret du webhook
# (https://<app>/api/v1/payments/stripe/webhook). Vides : inscriptions payantes fermées.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Notifications web push (VAPID, base64url) : pnpm --filter api vapid:keys en génère une paire.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Emails : « log » écrit le message dans le journal (poste local, refusé quand
# PUBLIC_APP_URL est en https hors localhost), « ses » envoie par Amazon SES.
MAIL_TRANSPORT=log
MAIL_FROM=Tournoi Connect <noreply@tournoi-connect.com>
AWS_REGION=eu-west-3
# Connexion en un clic (facultatif) : un fournisseur sans identifiants n'est pas proposé.
# URL de retour à déclarer chez chaque fournisseur : <PUBLIC_APP_URL>/api/v1/auth/oauth/<google|apple|facebook>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
