# Copier en .env pour le développement local (jamais commité).
NODE_ENV=development
PORT=3000
# Origine publique de la PWA (liens dans les emails, redirections).
PUBLIC_APP_URL=http://localhost:4200
DATABASE_URL=postgresql://tournoi:tournoi@localhost:5432/tournoi_connect
REDIS_URL=redis://localhost:6379
LOG_LEVEL=debug
# Secret des comptes (jetons, codes de connexion, liens rapporteur) : 32 caractères minimum.
# Générer une valeur locale, par exemple : openssl rand -hex 32
AUTH_SECRET=
# Préprod seulement : code fixe à 6 chiffres des comptes de test @example.org (jamais en prod).
TEST_ACCOUNTS_CODE=
# Emails : « log » écrit le message dans le journal (poste local), « ses » envoie par Amazon SES.
MAIL_TRANSPORT=log
MAIL_FROM=Tournoi Connect <noreply@tournoi-connect.com>
AWS_REGION=eu-west-3
# Connexion en un clic (facultatif) : un fournisseur sans identifiants n'est pas proposé.
# URL de retour à déclarer chez chaque fournisseur : <PUBLIC_APP_URL>/api/v1/auth/oauth/<google|apple|facebook>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
